rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isBootstrapAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'shahriarislam275@gmail.com';
    }

    function isAdmin() { 
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); 
    }

    // Global Statistics
    match /global_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Profiles
    match /students/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Admin Registry
    match /admins/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Question bank
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Exam Events
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write, create, update, delete: if isSignedIn();
    }

    // Exam Results
    match /results/{resultId} {
      allow read: if true;
      allow write, create, update, delete: if isSignedIn();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read, write, create, update, delete: if isSignedIn();
    }

    // Academic Resources
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Exam Submissions
    match /submissions/{submissionId} {
      allow read, write, create, update, delete: if isSignedIn();
    }

    // Deleted Users self-cleaning registry
    match /deleted_users/{uid} {
      allow read, write, create, update, delete: if true;
    }
  }
}
